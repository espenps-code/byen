{
  "rules": {
    "byer": {
      "$by": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid",
        "laererUid": {
          ".write": "auth != null && auth.provider !== 'anonymous' && (!data.exists() || data.val() === auth.uid)"
        },
        "innstillinger": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid"
        },
        "katalog": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid"
        },
        "jobber": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid"
        },
        "ansettelser": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid"
        },
        "teller": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid"
        },
        "logg": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid"
        },
        "kontoer": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid",
          "$konto": {
            "avtale": {
              ".write": "auth != null && !data.child('signert').exists()"
            }
          }
        },
        "trans": {
          "$konto": {
            "$t": {
              ".write": "auth != null && (root.child('byer/' + $by + '/laererUid').val() === auth.uid || (!data.exists() && newData.child('belop').isNumber() && newData.child('belop').val() < 0) || (!data.exists() && newData.child('belop').isNumber() && newData.child('belop').val() > 0 && root.child('byer/' + $by + '/kontoer/' + $konto + '/type').val() === 'bedrift' && !root.child('byer/' + $by + '/kjop/' + $t).exists() && newData.parent().parent().parent().child('kjop/' + $t + '/til').val() === $konto && newData.parent().parent().parent().child('kjop/' + $t + '/sum').val() === newData.child('belop').val() && newData.parent().parent().parent().child('kjop/' + $t + '/fra').val() !== $konto && newData.parent().parent().parent().child('trans/' + newData.parent().parent().parent().child('kjop/' + $t + '/fra').val() + '/' + $t + '/belop').val() === -newData.child('belop').val()))"
            }
          }
        },
        "bestillinger": {
          "$b": {
            ".write": "auth != null && (root.child('byer/' + $by + '/laererUid').val() === auth.uid || (!data.exists() && newData.child('status').val() === 'sendt'))"
          }
        },
        "soknader": {
          "$konto": {
            ".write": "auth != null && (root.child('byer/' + $by + '/laererUid').val() === auth.uid || (data.child('status').val() !== 'godkjent' && (newData.child('status').val() === 'utkast' || newData.child('status').val() === 'sendt')))"
          }
        },
        "post": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid",
          "$konto": {
            "$p": {
              "svar": {
                ".write": "auth != null && !data.exists()"
              },
              "lest": {
                ".write": "auth != null"
              }
            }
          }
        },
        "forslag": {
          ".write": "auth != null && root.child('byer/' + $by + '/laererUid').val() === auth.uid",
          "$f": {
            ".write": "auth != null && !data.exists() && newData.child('status').val() === 'samler'",
            "stotte": {
              ".write": "auth != null"
            }
          }
        },
        "jobbsoknader": {
          ".write": "auth != null"
        },
        "regnskap": {
          ".write": "auth != null"
        },
        "budsjett": {
          ".write": "auth != null"
        },
        "kjop": {
          "$k": {
            ".write": "auth != null && (root.child('byer/' + $by + '/laererUid').val() === auth.uid || (!data.exists() && newData.child('status').val() === 'betalt' && newData.child('sum').isNumber() && newData.child('sum').val() > 0 && newData.parent().parent().child('trans/' + newData.child('fra').val() + '/' + $k + '/belop').val() === -newData.child('sum').val() && newData.parent().parent().child('trans/' + newData.child('til').val() + '/' + $k + '/belop').val() === newData.child('sum').val()))",
            "status": {
              ".write": "auth != null && data.val() === 'betalt' && newData.val() === 'levert'"
            }
          }
        },
        "butikker": {
          "$b": {
            ".write": "auth != null && root.child('byer/' + $by + '/kontoer/' + $b + '/type').val() === 'bedrift'",
            "varer": {
              "$v": {
                "pris": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                }
              }
            }
          }
        }
      }
    },
    "laerere": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}